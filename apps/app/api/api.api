// video模块
@server(
	prefix: /douyin
	group: video
)
service api-api {
	@handler Feedhandler
	get /feed (douyin_feed_request) returns (douyin_feed_response)

	@handler PublishActionHandler
	post /publish/action (douyin_publish_action_request) returns (douyin_publish_action_response)

	@handler PublishListHandler
	post /publish/list (douyin_publish_list_request) returns (douyin_publish_list_response)
}

type (
	douyin_feed_request {
	}
	douyin_feed_response {
	}
	douyin_publish_action_request {
	}
	douyin_publish_action_response {
	}

	douyin_publish_list_request {
	}
	douyin_publish_list_response {
	}
)

// user模块
@server (
	prefix: douyin/user
	group: user
)
service api-api {
	@handler RegisterHandler
	post /register (userRegisterRequest) returns (userRegisterResponse)

	@handler LoginHandler
	post /login (douyin_user_login_request) returns (douyin_user_login_response)

	@handler InfoHandler
	get /info (douyin_user_info_request) returns (douyin_user_info_response)
}

type (
	userRegisterRequest {
		Username string `json:"username"`
		Password string `json:"Password"`
	}
	userRegisterResponse {
		StatusCode int32  `json:"status_code"`
		StatusMsg  string `json:"status_msg"`
		UserId     int64  `json:"user_id"`
		Token      string `json:"token"`
	}

	douyin_user_login_request {
	}

	douyin_user_login_response {
	}

	douyin_user_info_request {
	}

	douyin_user_info_response {
	}
)

